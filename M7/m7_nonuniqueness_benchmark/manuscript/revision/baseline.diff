+QUICK_DEVELOPMENT_SEEDS = tuple(range(8701, 8717))
+QUICK_TEST_SEEDS = tuple(range(8751, 8767))
+BOOTSTRAP_SAMPLES = 10_000
+LOO_ITERATIONS = 3
