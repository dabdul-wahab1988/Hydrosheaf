+        block = f"**Table {number}.** {caption}\n\n{_table_body(TABLES / filename)}"
+        text = text.replace(f"[[TAB:{key}]]", block)
+    unresolved = re.findall(r"\[\[(?:FIG|FIGREF|TAB|TABREF):[^]]+\]\]", text)
