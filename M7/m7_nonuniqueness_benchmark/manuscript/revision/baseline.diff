+    (REVISION / "change_log.json").write_text(json.dumps(change_log, indent=2) + "\n", encoding="utf-8")
+    (REVISION / "analysis_changes.json").write_text(json.dumps(analysis_log, indent=2) + "\n", encoding="utf-8")
