+def main() -> int:
+    OUTPUT.mkdir(parents=True, exist_ok=True)
+    TABLES.mkdir(parents=True, exist_ok=True)
+    input_hashes = {}
+    input_hashes.update(verify_locked_bundle(M74))
+    input_hashes.update(verify_locked_bundle(M75))
