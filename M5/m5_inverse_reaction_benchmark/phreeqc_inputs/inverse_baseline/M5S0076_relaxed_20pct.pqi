    log_k 0.0
M5_kfeldspar
    KHCO3 = K+ + HCO3-
    log_k 0.0
M5_fluorite
    CaF2 = Ca+2 + 2 F-
    log_k 0.0
M5_apatite
    Ca5(PO4)3F = 5 Ca+2 + 3 PO4-3 + F-
    log_k 0.0
M5_pyriteox
    FeS2 + 3.5 O2 + H2O = Fe+2 + 2 SO4-2 + 2 H+
    log_k 0.0
M5_halite
    NaCl = Na+ + Cl-
    log_k 0.0
M5_NO3src
    HNO3 = H+ + NO3-
    log_k 0.0
M5_denit
    CH2O + 0.8 NO3- = 0.4 N2 + 0.8 HCO3- + 0.2 CO2 + 0.6 H2O
    log_k 0.0
M5_calcite
    Ca(HCO3)2 = Ca+2 + 2 HCO3-
    log_k 0.0
M5_dolomite
    CaMg(HCO3)4 = Ca+2 + Mg+2 + 4 HCO3-
    log_k 0.0
M5_gypsum
    CaSO4:2H2O = Ca+2 + SO4-2 + 2 H2O
    log_k 0.0
END

